# Server Configuration
# PORT=3001

# Railway MySQL (preferred)
# DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
# or use the individual Railway variables:
# MYSQLHOST=<railway-db-host>
# MYSQLPORT=3306
# MYSQLUSER=<railway-db-user>
# MYSQLPASSWORD=<railway-db-password>
# MYSQLDATABASE=<railway-db-name>
# MYSQL_SSL=true

# Optional local fallback for XAMPP/MySQL development
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=''
# DB_NAME=surema_fashion

# JWT Configuration
# JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# JWT_EXPIRES_IN=7d
